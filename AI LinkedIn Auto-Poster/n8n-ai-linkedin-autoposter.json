{
  "name": "AI LinkedIn Auto-Poster",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Name the image after the sheet topic (e.g. \"intel-18a-foundry.jpeg\"),\n// falling back to a timestamp only if the topic is empty.\nconst topic = String($('Get row(s) in sheet').first().json['Topic'] || '').trim();\nconst slug = topic\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-')   // non-alphanumeric -> hyphen\n  .replace(/^-+|-+$/g, '')       // trim leading/trailing hyphens\n  .slice(0, 50);                 // keep filenames reasonably short\n\nfor (const item of $input.all()) {\n  const key = item.binary ? Object.keys(item.binary)[0] : undefined;\n  if (!key) {\n    throw new Error(\"Image generation returned no binary data - check the 'Generate Image (Pollinations)' node.\");\n  }\n\n  const mimeType = item.binary[key].mimeType || 'image/jpeg';\n  if (!mimeType.startsWith('image/')) {\n    throw new Error(`Pollinations returned \"${mimeType}\" instead of an image - check the API key / prompt.`);\n  }\n  const ext = mimeType.split('/')[1] || 'jpg';\n  const fileName = slug ? `${slug}.${ext}` : `generated-image-${Date.now()}.${ext}`;\n\n  item.json.fileName = fileName;\n  item.binary[key].fileName = fileName;\n\n  // LinkedIn node reads the binary property called \"data\"\n  if (key !== 'data') {\n    item.binary.data = item.binary[key];\n    delete item.binary[key];\n  }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
