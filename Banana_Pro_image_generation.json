        "jsCode": "const item = $input.item.json;\nlet imageUrl = null;\n\ntry {\n  const parsed = JSON.parse(item.data.resultJson);\n  if (parsed.resultUrls && parsed.resultUrls.length > 0) {\n    imageUrl = parsed.resultUrls[0];\n  }\n} catch (e) {\n  imageUrl = null;\n}\n\nreturn [{\n  json: {\n    imageUrl,\n    parseError: imageUrl === null,\n    taskId: item.data.taskId\n  }\n}];"
      },
