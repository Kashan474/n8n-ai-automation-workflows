    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Use this tool to look up current, factual information on the web if the revision requires extra facts.",
        "query": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('query', 'The web search query needed for the revision') }}",
        "options": {
