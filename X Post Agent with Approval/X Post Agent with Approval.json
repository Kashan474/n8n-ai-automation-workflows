      "id": "649eb3eb-684e-42af-888c-86488540f9ab",
      "name": "Tavily Search1",
      "type": "@tavily/n8n-nodes-tavily.tavilyTool",
      "typeVersion": 1,
      "position": [
        1832,
        808
      ],
      "credentials": {
        "tavilyApi": {
          "id": "rcgJ8E5bej1uOfhT",
          "name": "Tavily account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const MAX = 280;\nconst MAX_AUTOFIX_REVISION = 4;\nconst results = [];\n\nfor (const item of $input.all()) {\n  let post = String(item.json.post ?? '').trim();\n  // Strip wrapping quotes the model sometimes adds\n  post = post.replace(/^[\"'“”‘’]+|[\"'“”‘’]+$/g, '').trim();\n\n  // Count code points (emoji-safe). X weights URLs/CJK/emoji differently,\n  // so treat this as a close approximation.\n  const length = [...post].length;\n  const empty = post.length === 0;\n  const tooLong = length > MAX;\n  const valid = !empty && !tooLong;\n  const revision = Number(item.json.revision ?? 0);\n\n  results.push({\n    json: {\n      ...item.json,\n      post,\n      length,\n      valid,\n      autoFix: !valid && revision < MAX_AUTOFIX_REVISION,\n      feedback: valid\n        ? null\n        : empty\n          ? 'The post was empty. Write a complete X post of at most 280 characters with 1-3 hashtags.'\n          : `The post is ${length} characters. Shorten it to at most ${MAX} characters, keeping 1-3 hashtags.`,\n    },\n  });\n}\n\nreturn results;"
      },
