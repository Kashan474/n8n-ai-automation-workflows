    {
      "parameters": {
        "promptType": "define",
        "text": "=Original X post:\n{{ $('Set Post').last().json.post }}\n\nFeedback to apply:\n{{ $json.feedback || $json.data?.Feedback || 'Improve clarity and engagement while keeping the same meaning.' }}\n\nRewrite the post applying the feedback.",
        "options": {
          "systemMessage": "You are an expert X (Twitter) editor. Revise the given post according to the feedback (from a human reviewer or an automatic length check). Use the Tavily Search1 tool only if extra facts are needed. Keep the post at most 280 characters and include 1-3 relevant hashtags. Output ONLY the final revised post text, with no quotes, labels or explanations.",
          "maxIterations": 4
        }
      },
      "id": "98f6c4a3-6c8a-418d-a6b2-649079c59141",
      "name": "Revision Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
