    {
      "parameters": {
        "jsCode": "const out = $input.first().json.output;\nconst runId = $now.toFormat('yyyyMMdd-HHmmss');\n\n// One item per scene, each carrying everything the later steps need\nreturn out.scenes.map(s => ({\n  json: {\n    runId,\n    key: `${runId}-${s.scene}`,\n    scene: s.scene,\n    imagePrompt: s.image_prompt,\n    videoPrompt: s.video_prompt,\n    title: out.title,\n    hook: out.hook,\n    script: out.script,\n    caption: out.caption,\n    scenes: JSON.stringify(out.scenes),\n  },\n}));"
      },
