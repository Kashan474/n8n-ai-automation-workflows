      "name": "Get Previous Scripts",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        224,
        96
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Previous scripts (do not repeat these topics or hooks): {{ $('Get Previous Scripts').all().map(i => i.json.Script).filter(Boolean).slice(-10).join(' | ') || 'None yet' }}\n\nWrite one new short-form vertical video script (about 30 seconds) and split it into 4 scenes of about 8 seconds each.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert short-form video creator. Niche: AI and automation tips for freelancers and small business owners.\n\n1) SCRIPT: punchy and original, with a strong hook, one clear idea and a call to action. Plain spoken voiceover only (60-75 words, about 30 seconds): no timestamps, scene labels, emojis or stage directions.\n\n2) SCENES: split the script into exactly 4 sequential scenes of about 8 seconds each, keeping the hook in scene 1 and the call to action in scene 4. For each scene return:\n- beat: one short sentence describing what we see, followed by the spoken line (at most 20 words).\n- image_prompt: a vivid prompt for the opening frame covering subject, setting, lighting, camera angle and style. Keep the same characters, style and colour palette across all 4 images, vertical 9:16 composition.\n- video_prompt: an image-to-video prompt for Grok Imagine. The starting frame is supplied, so do not re-describe it. Write 2-3 sentences covering camera movement, subject action, ambient sound and the spoken line in double quotes (taken from the beat, at most 20 words). Do not mention duration, aspect ratio or art style.\n\nReturn only the requested JSON."
        }
      },
      "id": "d2e07ea7-c404-465b-8e7a-af5db6ed7b39",
      "name": "Write Script & Scenes",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
        96
      ],
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"title\": \"Short catchy title\", \"hook\": \"Scroll-stopping first line\", \"script\": \"Full voiceover script (about 30 seconds)\", \"caption\": \"Social caption with hashtags\", \"scenes\": [ { \"scene\": 1, \"beat\": \"What we see and the spoken line\", \"image_prompt\": \"Opening-frame image prompt\", \"video_prompt\": \"Camera movement, action, ambience and spoken line\" }, { \"scene\": 2, \"beat\": \"...\", \"image_prompt\": \"...\", \"video_prompt\": \"...\" }, { \"scene\": 3, \"beat\": \"...\", \"image_prompt\": \"...\", \"video_prompt\": \"...\" }, { \"scene\": 4, \"beat\": \"...\", \"image_prompt\": \"...\", \"video_prompt\": \"...\" } ] }"
      },
      "id": "ba203020-6ddb-4d06-92c2-b41a63e1dd4c",
      "name": "Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        592,
        336
      ]
