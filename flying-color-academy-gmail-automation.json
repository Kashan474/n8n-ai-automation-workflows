    {
      "parameters": {
        "inputText": "={{ $json.query }}",
        "categories": {
          "categories": [
            {
              "category": "Admission",
              "description": "User wants to enroll, register, ask about the admission process, fees, or take admission for their child at Flying Color Academy."
            },
            {
              "category": "Query",
              "description": "User is asking a general question or wants information, not specifically about enrolling or admission."
            },
            {
              "category": "Fallback",
              "description": "Message is too vague, greeting only, empty, irrelevant, or does not clearly match admission or general query. Examples: Hello, Hi, OK, Thanks, Test"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You are an intent classifier for a tuition academy inquiry form.\nClassify the user message into exactly one of three categories:\nAdmission, Query, or Fallback.\nIf the message is a greeting, too short, vague, or does not relate\nto education or the academy, always classify it as Fallback.\nNever force a message into Admission or Query if it does not clearly belong there."
        }
      },
      "id": "b30d7378-3a35-4137-a4a0-0bf7490f214c",
      "name": "Intent Classifier",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1,
      "position": [
        -416,
        512
      ]
