      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "id": "d1ba424e-e26f-485e-a410-5548eb7dfc00",
      "name": "Gemini for Classifier",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
