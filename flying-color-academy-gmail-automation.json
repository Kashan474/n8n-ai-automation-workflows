    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"subject\": {\n      \"type\": \"string\",\n      \"description\": \"A warm personalized email subject line for the admission inquiry. Under 10 words. No punctuation at end. Example: Welcome to Flying Color Academy Ayesha\"\n    },\n    \"message\": {\n      \"type\": \"string\",\n      \"description\": \"A fully formatted HTML email body. Use these HTML tags only: <p> for each paragraph, <strong> for bold emphasis, <br> for line breaks. Structure: start with <p>Dear [name],</p> then 2 to 3 body paragraphs each wrapped in <p></p> then a sign-off paragraph. Do NOT include <html> <head> <body> or <style> tags. Do NOT repeat the subject line inside the message. Do NOT use plain text. Every sentence must be inside an HTML tag.\"\n    }\n  },\n  \"required\": [\"subject\", \"message\"]\n}"
      },
