              "id": "f1a2b3c4-0001-4000-8000-000000000001",
              "leftValue": "={{ $json.bot_id }}",
              "operator": {
                "operation": "empty",
                "type": "string"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          }
        },
        "options": {}
      },
      "id": "83da1ee0-fdb0-42dc-9dbb-40eab4f65ff2",
      "name": "Filter Out Bot Messages",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "notes": "Blocks events where bot_id is set, preventing the bot from replying to its own messages or other bots (avoids echo/duplicate-reply loops)."
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL_ID"
        },
        "text": "={{ $json.output }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "076c974e-64b7-48eb-9f97-15fec25d0725",
      "name": "Send a message",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.5,
      "position": [
        1072,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL_ID"
        },
        "text": "=Sorry — I ran into an issue looking that up. Please try again in a moment, or reach out to HR directly if it's urgent.",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "6e115c4d-fc7a-402b-9007-218742d8e508",
      "name": "Send Fallback Message",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.5,
      "position": [
        1072,
        192
      ],
      "notes": "Fires only when the AI Agent errors out (Pinecone/OpenAI failure, timeout, etc.) instead of letting the workflow fail silently."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "You are NovaCore's internal HR assistant. Your job is to give accurate, concise, and helpful answers to employee questions about company policies.\n\n## Tool Usage\nYou have access to a Pinecone Vector Store tool containing NovaCore's official employee policy documents (leave policy, workplace conduct, code of behavior, and related HR rules and regulations).\n\n- Always call the Pinecone Vector Store tool whenever a question relates to employee policies, rules, regulations, leave, attendance, conduct, benefits, or workplace behavior — even if you think you already know the answer. Never answer policy questions from memory alone.\n- Base your answer strictly on the information returned by the tool. Do not add details, assumptions, or numbers that are not present in the retrieved content.\n- If the tool returns no relevant information, say so clearly and suggest the employee contact HR directly — do not guess or fabricate a policy.\n\n## Response Style\n- Keep answers clear, professional, and to the point — avoid unnecessary padding.\n- When a policy has specific numbers, timeframes, or conditions (e.g., \"12 paid leaves per year\"), state them exactly as retrieved.\n- If a question is ambiguous, ask a brief clarifying question before answering.\n- If a question is unrelated to NovaCore policies (general knowledge, small talk, etc.), you may answer normally without using the tool."
        }
      },
      "id": "420f86c4-8eec-4c03-9e5b-243a0c0ddc4d",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        512,
        96
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "cachedResultName": "gpt-4o-mini",
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "8af830b2-e3b1-40bc-ab65-cbf94bac6d27",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        464,
        336
      ],
      "notes": "Attach your own OpenAI API credential before use. A dedicated key avoids shared rate limits and unpredictable costs."
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.user }}_{{ $json.channel }}",
        "contextWindowLength": 15
      },
      "id": "ce8042ce-d4cd-4a47-8ea5-f3967c200f6c",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        592,
        336
      ],
      "notes": "Session key changed from blocks[0].block_id (unstable per message) to user+channel, so conversation memory persists reliably per employee per channel."
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Always use this tool to answer any question related to NovaCore employee policies, including leave policy, attendance rules, workplace conduct/behaviour, code of conduct, benefits, and other HR rules and regulations.",
