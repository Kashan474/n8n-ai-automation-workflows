{
  "name": "AI Lead Capture & Smart Reply Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "8c0dbc8b-1caa-57ab-8a31-73c15005bcb4",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        320,
        576
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "ownerName",
              "type": "string",
              "value": "Muhammad Nadeem"
            },
            {
              "id": "c2",
              "name": "ownerBio",
              "type": "string",
              "value": "an n8n AI automation specialist and Python instructor"
            },
            {
              "id": "c3",
              "name": "brandName",
              "type": "string",
              "value": "Muhammad Nadeem"
            },
            {
              "id": "c4",
              "name": "ownerPhone",
              "type": "string",
              "value": "923XXXXXXXXX"
            },
            {
              "id": "c5",
              "name": "waPhoneNumberId",
              "type": "string",
              "value": "YOUR_WHATSAPP_PHONE_NUMBER_ID"
            },
            {
              "id": "c6",
              "name": "formToken",
              "type": "string",
              "value": ""
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "97d3fed7-4d7d-53ce-8d0b-a9e70e0e3001",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        544,
        576
      ],
      "notes": "Edit ONLY this node to customise the template. ownerPhone = your WhatsApp number in international format without '+'. waPhoneNumberId = WhatsApp Business Cloud API phone number ID."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "ticketId",
              "type": "string",
              "value": "=LEAD-{{ $now.toFormat(\"yyMMdd\") }}-{{ $execution.id }}"
            },
            {
              "id": "a2",
              "name": "name",
              "type": "string",
              "value": "={{ ($json.body?.name ?? $json.name ?? \"Guest\").toString().replace(/[\\r\\n]+/g, \" \").trim().slice(0, 80) || \"Guest\" }}"
            },
            {
              "id": "a3",
              "name": "email",
              "type": "string",
              "value": "={{ ($json.body?.email ?? $json.email ?? \"\").toString().trim().toLowerCase().slice(0, 120) }}"
            },
            {
              "id": "a4",
              "name": "phone",
              "type": "string",
              "value": "={{ (() => { const p = ($json.body?.phone ?? $json.phone ?? \"\").toString().replace(/[^0-9+() -]/g, \"\").trim().slice(0, 20); return p.replace(/[^0-9]/g, \"\").length >= 7 ? p : \"\"; })() }}"
            },
            {
              "id": "a5",
              "name": "category",
              "type": "string",
              "value": "={{ [\"General Question\",\"Pricing\",\"Services\",\"Support\",\"Collaboration\",\"Other\"].includes($json.body?.category ?? $json.category) ? ($json.body?.category ?? $json.category) : \"Other\" }}"
            },
            {
              "id": "a6",
              "name": "question",
              "type": "string",
              "value": "={{ ($json.body?.question ?? $json.question ?? \"\").toString().trim() }}"
            },
            {
              "id": "a7",
              "name": "honeypot",
              "type": "string",
              "value": "={{ $json.body?.honeypot ?? \"\" }}"
            },
            {
              "id": "a8",
              "name": "submittedAt",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "a9",
              "name": "source",
              "type": "string",
              "value": "={{ ($json.body?.source ?? \"website-form\").toString().slice(0, 40) }}"
            },
            {
              "id": "a10",
              "name": "sessionId",
              "type": "string",
              "value": "={{ (($json.headers?.[\"x-forwarded-for\"] ?? \"\").toString().split(\",\")[0].replace(/[^a-zA-Z0-9]/g, \"-\").slice(0, 45) || \"noip\") + \"_\" + (($json.body?.sessionId ?? \"\").toString().replace(/[^a-zA-Z0-9_-]/g, \"\").slice(0, 64) || (\"anon-\" + $execution.id)) }}"
            },
            {
              "id": "a11",
              "name": "ip",
              "type": "string",
              "value": "={{ ($json.headers?.[\"x-forwarded-for\"] ?? \"\").toString().split(\",\")[0].replace(/[^0-9a-fA-F.:]/g, \"\").slice(0, 45) }}"
            },
            {
              "id": "a12",
              "name": "tokenOk",
              "type": "boolean",
              "value": "={{ !$json.formToken || $json.headers?.[\"x-form-token\"] === $json.formToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b1b822ca-ec02-5c8e-818e-ade29230afab",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        768,
        576
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.question.length }}",
              "operator": {
                "operation": "gte",
                "type": "number"
              },
              "rightValue": 10
            },
            {
              "id": "v2",
              "leftValue": "={{ $json.question.length }}",
              "operator": {
                "operation": "lte",
                "type": "number"
              },
              "rightValue": 1000
            },
            {
              "id": "v3",
              "leftValue": "={{ $json.email }}",
              "operator": {
                "operation": "regex",
                "type": "string"
              },
              "rightValue": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            },
            {
              "id": "v4",
              "leftValue": "={{ $json.honeypot }}",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              },
              "rightValue": ""
            },
            {
              "id": "v5",
              "leftValue": "={{ $json.tokenOk }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "52f585db-ec3c-5215-94a9-1779eceea27d",
      "name": "Valid Submission?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        992,
        576
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "visitor_email",
              "condition": "eq",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "orderBy": true,
        "orderByColumn": "createdAt",
        "orderByDirection": "DESC"
      },
      "id": "d22b5487-abaf-556e-baac-85f449f1f7bb",
      "name": "Check Recent Submission",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1104,
        288
      ],
      "notes": "Looks up the visitor's most recent log row (by email) so 'Rate Limited?' can compare its createdAt with now. Returns an empty item when no row exists.",
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "rl1",
              "leftValue": "={{ $json.createdAt ? $now.diff(DateTime.fromISO(String($json.createdAt)), \"seconds\").seconds < 120 : false }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0e09f2b5-2ad4-5d3f-aab5-e1afffb2a6a7",
      "name": "Rate Limited?",
