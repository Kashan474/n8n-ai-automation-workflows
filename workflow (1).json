      "typeVersion": 2.3,
      "position": [
        1216,
        288
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"error\": \"You already sent a question a moment ago. Please wait about two minutes and try again.\" } }}",
        "options": {
          "responseCode": 429
        }
      },
      "id": "f41f2ed8-94f4-5b91-ab5e-4b4bbd19bb01",
      "name": "Respond - Rate Limited",
