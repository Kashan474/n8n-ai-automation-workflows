    {
      "parameters": {},
      "id": "2e28e627-6cd4-5f1b-bdbe-078090e504e3",
      "name": "Calculator",
      "type": "@n8n/n8n-nodes-langchain.toolCalculator",
      "typeVersion": 1,
      "position": [
        1968,
        512
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"answer\": { \"type\": \"string\", \"description\": \"Clear, helpful answer for the visitor (max 150 words)\" },\n    \"intent\": { \"type\": \"string\", \"enum\": [\"project_inquiry\", \"hiring\", \"collaboration\", \"training_learning\", \"support\", \"general_question\", \"spam\"] },\n    \"lead_score\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 },\n    \"sentiment\": { \"type\": \"string\", \"enum\": [\"positive\", \"neutral\", \"negative\"] },\n    \"needs_human_followup\": { \"type\": \"boolean\" },\n    \"followup_reason\": { \"type\": \"string\" },\n    \"suggested_next_step\": { \"type\": \"string\" }\n  },\n  \"required\": [\"answer\", \"intent\", \"lead_score\", \"sentiment\", \"needs_human_followup\", \"followup_reason\", \"suggested_next_step\"]\n}",
        "autoFix": true
      },
      "id": "10873ced-fef1-5612-b9ce-e0ba6a08d965",
      "name": "Answer Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
